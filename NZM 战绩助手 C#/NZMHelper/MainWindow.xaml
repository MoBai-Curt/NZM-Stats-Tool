<Window x:Class="NZMHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NZM 战绩助手 V1.6.0" Height="850" Width="1280"
        Background="{DynamicResource WindowBackgroundBrush}" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">

    <Grid>
        <Grid Visibility="{DynamicResource GlassBackgroundVisibility}" ZIndex="-1" IsHitTestVisible="False">
            <Canvas>
                <Ellipse Width="800" Height="800" Canvas.Top="-300" Canvas.Left="-100" Opacity="0.4">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#4361EE" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <Grid x:Name="LoginGrid" Visibility="Visible" ZIndex="100" Background="{DynamicResource BgBrush}">
            <Border Width="450" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,30">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <Image Source="/favicon.ico" Width="64" Height="64" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="NZM 战绩助手" Foreground="{DynamicResource TextMainBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="AUTO CAPTURE EDITION" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" Opacity="0.8" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <TextBlock Text="1. 请选择您要查询的区服" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="13"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <RadioButton x:Name="RadioZoneQQ" Content="QQ 区" IsChecked="True" Foreground="{DynamicResource TextMainBrush}" FontSize="14" Margin="0,0,30,0" Cursor="Hand"/>
                            <RadioButton x:Name="RadioZoneWx" Content="微信区" Foreground="{DynamicResource TextMainBrush}" FontSize="14" Cursor="Hand"/>
                        </StackPanel>

                        <Border Background="#1AFFFFFF" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="TxtCaptureStatus" Text="等待操作：点击下方按钮开启拦截" Foreground="{DynamicResource TextSubBrush}" TextAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                <Button x:Name="BtnStartCapture" Content="开启自动抓取 (推荐)" Click="BtnStartCapture_Click" Background="{DynamicResource GreenBrush}" Foreground="White" Height="40" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2. 或手动粘贴抓包的 Cookie:" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,5" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="CookieInput" Height="60" TextWrapping="Wrap" Background="#22FFFFFF" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource DividerBrush}" Padding="10" VerticalContentAlignment="Top" CaretBrush="{DynamicResource AccentBrush}"/>

                        <Button Content="验证并登录" Click="BtnLoginManual_Click" Background="{DynamicResource AccentBrush}" Foreground="White" Width="200" Height="40" Margin="0,20,0,0" BorderThickness="0" Cursor="Hand" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="MainGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource NavBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="48" Height="48" CornerRadius="8" Margin="0,0,0,30" Background="#22FFFFFF" ClipToBounds="True">
                        <Image Source="/favicon.ico" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding ElementName=TxtAppTitle, Path=Text}"/>
                    </Border>
                    <TextBlock x:Name="TxtAppTitle" Visibility="Collapsed" Text="NZM Helper"/>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <RadioButton Content="&#xE9D2;" ToolTip="战绩概览" Style="{StaticResource IconNavButtonStyle}" IsChecked="True" Click="Nav_Stats_Click"/>
                        <RadioButton Content="&#xE8F1;" ToolTip="图鉴查询" Style="{StaticResource IconNavButtonStyle}" Click="Nav_Coll_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Height="1" Width="30" Background="{DynamicResource DividerBrush}" Margin="0,20"/>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                        <Button Content="&#xE74C;" ToolTip="碎片悬浮窗" Click="BtnOpenFragment_Click" Style="{StaticResource IconButtonStyle}"/>
                        <Button Content="&#xE896;" ToolTip="检查更新" Click="BtnCheckUpdate_Click" Style="{StaticResource IconButtonStyle}"/>
                        <Button Content="&#xE946;" ToolTip="公告" Click="BtnAuthorInfo_Click" Style="{StaticResource IconButtonStyle}"/>
                        <Button Content="&#xE790;" ToolTip="切换主题" Click="BtnSwitchTheme_Click" Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Content="&#xE72C;" ToolTip="刷新数据" Click="BtnRefresh_Click" Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource GreenBrush}"/>
                        <Button Content="&#xF3B1;" ToolTip="退出登录" Click="BtnLogout_Click" Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource RedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ViewStats" Visibility="Visible" Padding="40,30">
                    <StackPanel>
                        <TextBlock Text="DASHBOARD" Foreground="{DynamicResource TextSubBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="战绩概览" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,25"/>

                        <UniformGrid Columns="2" Margin="0,0,0,30">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="历史总场次" Foreground="{DynamicResource TextSubBrush}"/>
                                        <TextBlock x:Name="TxtTotalGames" Text="--" Foreground="{DynamicResource TextMainBrush}" FontSize="40" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.1" Foreground="{DynamicResource TextMainBrush}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="历史总时长" Foreground="{DynamicResource TextSubBrush}"/>
                                        <TextBlock x:Name="TxtTotalHours" Text="--" Foreground="{DynamicResource TextMainBrush}" FontSize="40" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.1" Foreground="{DynamicResource TextMainBrush}"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="近期表现" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                        <UniformGrid Columns="3" Margin="0,0,0,30">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="近期场次" Foreground="{DynamicResource TextSubBrush}"/>
                                    <TextBlock x:Name="TxtRecentCount" Text="--" Foreground="{DynamicResource TextMainBrush}" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="近期胜率" Foreground="{DynamicResource TextSubBrush}"/>
                                    <TextBlock x:Name="TxtRecentWinRate" Text="--" Foreground="{DynamicResource GreenBrush}" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="场均得分" Foreground="{DynamicResource TextSubBrush}"/>
                                    <TextBlock x:Name="TxtRecentAvgDmg" Text="--" Foreground="{DynamicResource LegendaryBrush}" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="常玩地图 TOP" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                    <ItemsControl x:Name="MapStatList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,10,15" MinHeight="80">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="8" ClipToBounds="True" Background="#333" Height="60" VerticalAlignment="Top">
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="0.7"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding TotalWinRate}" Foreground="{DynamicResource TextSubBrush}" FontSize="12"/>
                                                        <ItemsControl ItemsSource="{Binding Diffs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextSubBrush}" FontSize="10" Opacity="0.7"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="模式偏好" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                    <ItemsControl x:Name="ModeStatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}"/>
                                                        <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource TextSubBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <TextBlock Text="对局历史" Foreground="{DynamicResource TextMainBrush}" FontSize="20" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="全部" Click="FilterGames_Click" Tag="all" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextSubBrush}" Margin="5,0" BorderThickness="0" Height="28">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="猎场" Click="FilterGames_Click" Tag="hunt" Background="Transparent" Foreground="{DynamicResource TextSubBrush}" Margin="5,0" BorderThickness="0" Height="28"/>
                                    <Button Content="塔防" Click="FilterGames_Click" Tag="td" Background="Transparent" Foreground="{DynamicResource TextSubBrush}" Margin="5,0" BorderThickness="0" Height="28"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl x:Name="GamesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RoomId}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="6" ClipToBounds="True" Height="45" Background="#111">
                                                    <Image Source="{Binding MapIcon}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontWeight="Bold" FontSize="15" Margin="0,0,15,0"/>
                                                        <TextBlock Text="{Binding Mode}" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource TextSubBrush}" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Score}" Foreground="{StaticResource LegendaryBrush}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource TextSubBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,30">
                                <Button Content="上一页" Click="BtnPagePrev_Click" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextSubBrush}" Width="100" Height="36" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock x:Name="TxtPageInfo" Text="1 / 1" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center" Margin="25,0"/>
                                <Button Content="下一页" Click="BtnPageNext_Click" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextSubBrush}" Width="100" Height="36" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ViewCollection" Visibility="Collapsed" Padding="40,30">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <TextBlock x:Name="TxtCollTitle" Text="图鉴收藏" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="武器" Click="SwitchColl_Click" Tag="weapon" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextMainBrush}" Margin="5,0" Height="30" Width="60" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="插件" Click="SwitchColl_Click" Tag="plugin" Background="Transparent" Foreground="{DynamicResource TextSubBrush}" Margin="5,0" Height="30" Width="60" BorderThickness="0"/>
                                <Button Content="塔防" Click="SwitchColl_Click" Tag="trap" Background="Transparent" Foreground="{DynamicResource TextSubBrush}" Margin="5,0" Height="30" Width="60" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="全部" Click="FilterColl_Click" Tag="all" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextSubBrush}" Height="26" FontSize="12" Margin="0,0,5,0" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="传说" Click="FilterColl_Click" Tag="4" Background="Transparent" BorderBrush="{StaticResource LegendaryBrush}" BorderThickness="1" Foreground="{StaticResource LegendaryBrush}" Height="26" FontSize="12" Margin="5,0"/>
                            <Button Content="史诗" Click="FilterColl_Click" Tag="3" Background="Transparent" BorderBrush="{StaticResource EpicBrush}" BorderThickness="1" Foreground="{StaticResource EpicBrush}" Height="26" FontSize="12" Margin="5,0"/>
                            <Button Content="稀有" Click="FilterColl_Click" Tag="2" Background="Transparent" BorderBrush="{StaticResource RareBrush}" BorderThickness="1" Foreground="{StaticResource RareBrush}" Height="26" FontSize="12" Margin="5,0"/>
                        </StackPanel>

                        <ItemsControl x:Name="CollectionList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" BorderBrush="{Binding BorderColor}" Margin="5" Padding="0">
                                        <Grid>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding BorderColor}" CornerRadius="0,8,0,8" Padding="6,2">
                                                <TextBlock Text="{Binding QualityText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel Margin="10">
                                                <Image Source="{Binding Icon}" Height="60" Margin="0,15,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>