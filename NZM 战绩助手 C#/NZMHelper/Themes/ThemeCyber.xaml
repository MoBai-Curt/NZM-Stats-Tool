<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#FF0F0C29" Offset="0.0"/>
		<GradientStop Color="#FF302B63" Offset="0.5"/>
		<GradientStop Color="#FF24243E" Offset="1.0"/>
	</LinearGradientBrush>

	<SolidColorBrush x:Key="BgBrush" Color="#CC0F0C29"/>

	<SolidColorBrush x:Key="NavBgBrush" Color="#40000000"/>

	<SolidColorBrush x:Key="CardBgBrush" Color="#20FFFFFF"/>
	<SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF"/>
	<SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF"/>

	<SolidColorBrush x:Key="AccentBrush" Color="#4361EE"/>

	<SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="TextSubBrush" Color="#a1a1aa"/>

	<SolidColorBrush x:Key="GreenBrush" Color="#10b981"/>
	<SolidColorBrush x:Key="RedBrush" Color="#ef4444"/>
	<SolidColorBrush x:Key="YellowBrush" Color="#f59e0b"/>

	<SolidColorBrush x:Key="LegendaryBrush" Color="#d4a84b"/>
	<SolidColorBrush x:Key="EpicBrush" Color="#a855f7"/>
	<SolidColorBrush x:Key="RareBrush" Color="#3b82f6"/>
	<SolidColorBrush x:Key="CommonBrush" Color="#71717a"/>

	<Visibility x:Key="GlassBackgroundVisibility">Visible</Visibility>
</ResourceDictionary>